from typing import Any
from pathlib import Path

class ControlRef:
    name: str | None
    library_id: str | None

Target = ControlRef | str | tuple[float, float] | list[float]
class Controls:
    def __getitem__(self, name: str) -> ControlRef: ...
    def by_id(self, library_id: str) -> ControlRef: ...

class Window:
    """操作当前连接的目标窗口，坐标相对于客户区。"""
    def size(self) -> tuple[int, int]: ...
    def locate(self, target: Target, timeout: float = 5) -> tuple[int, int]: ...
    def click(self, target: Target, button: str = 'left', count: int = 1, interval: float = 0.12, hold: float = 0, timeout: float = 5) -> Any: ...
    def drag(self, start: Target, end: Target, duration: float = 1, timeout: float = 5, path: Any = None, button: str = 'left') -> Any: ...
    def scroll(self, target: Target, amount: int = -3, axis: str = 'vertical', timeout: float = 5) -> Any: ...
    def key(self, keys: str) -> Any: ...
    def key_down(self, keys: str) -> Any: ...
    def key_up(self, keys: str) -> Any: ...
    def text(self, text: str) -> Any: ...
    def sleep(self, seconds: float) -> None: ...
    def assert_image(self, target: Target, timeout: float = 5) -> Any: ...
    def assert_absent(self, target: Target, timeout: float = 5) -> Any: ...
    def wait_ui(self, target: Target, timeout: float = 5) -> Any: ...
    def assert_ui(self, target: Target, timeout: float = 5) -> Any: ...
    def assert_ui_absent(self, target: Target, timeout: float = 5) -> Any: ...
    def screenshot(self) -> Path: ...
    def capture(self) -> Any: ...

window: Window
game: Window
controls: Controls
variables: dict[str, Any]
case_dir: Path
report_dir: Path
step_name: str
def render(value: Any) -> Any: ...
def assign(name: str, value: Any) -> None: ...
def run_script(code: str, timeout: float = 5, step_name: str | None = None) -> None: ...
